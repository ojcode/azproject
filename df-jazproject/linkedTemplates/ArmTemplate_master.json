{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "df-jazproject"
		},
		"AzDLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzDLS'"
		},
		"AzSQLDb_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzSQLDb'"
		},
		"AzDLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://jazprojectstorage.dfs.core.windows.net/"
		},
		"AzSQLDb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "jaz.database.windows.net"
		},
		"AzSQLDb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db-jazproject"
		},
		"AzSQLDb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "joseph-az"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "df-jazproject_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzDLS_accountKey": {
						"value": "[parameters('AzDLS_accountKey')]"
					},
					"AzSQLDb_password": {
						"value": "[parameters('AzSQLDb_password')]"
					},
					"AzDLS_properties_typeProperties_url": {
						"value": "[parameters('AzDLS_properties_typeProperties_url')]"
					},
					"AzSQLDb_properties_typeProperties_server": {
						"value": "[parameters('AzSQLDb_properties_typeProperties_server')]"
					},
					"AzSQLDb_properties_typeProperties_database": {
						"value": "[parameters('AzSQLDb_properties_typeProperties_database')]"
					},
					"AzSQLDb_properties_typeProperties_userName": {
						"value": "[parameters('AzSQLDb_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}